# Copy to .env and fill in. .env is git-ignored.

# Neon Postgres: pooled connection strings.
# DATABASE_URL uses the non-owner role synapsed_app, so row-level security applies.
# DATABASE_URL_ADMIN uses the owner role and is for migrations and seed scripts only.
DATABASE_URL=
DATABASE_URL_ADMIN=

# Neon Auth (Managed Better Auth): base URL from the Auth tab in the Neon console.
NEON_AUTH_BASE_URL=

# Neon Object Storage (S3-compatible): values from the branch storage API / credential.
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_REGION=
NEON_STORAGE_ACCESS_KEY=
NEON_STORAGE_SECRET_KEY=
NEON_STORAGE_BUCKET=resources

# CORS: the deployed frontend origin (http://localhost:5173 is always allowed).
FRONTEND_ORIGIN=

# AI providers (free keys): Groq for speech-to-text, Google AI Studio for embeddings.
GROQ_API_KEY=
GROQ_MODEL_WHISPER=whisper-large-v3-turbo
GOOGLE_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001

# Largest accepted upload, in MB.
MAX_UPLOAD_MB=50
