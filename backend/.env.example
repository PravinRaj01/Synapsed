# Copy to .env and fill in. .env is git-ignored.

# Neon Postgres: pooled connection strings.
# DATABASE_URL uses the non-owner role synapsed_app, so row-level security applies.
# DATABASE_URL_ADMIN uses the owner role and is for migrations and seed scripts only.
DATABASE_URL=
DATABASE_URL_ADMIN=

# Neon Auth (Managed Better Auth): base URL from the Auth tab in the Neon console.
NEON_AUTH_BASE_URL=

# Neon Object Storage (S3-compatible): values from the branch storage API / credential.
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_REGION=
NEON_STORAGE_ACCESS_KEY=
NEON_STORAGE_SECRET_KEY=
NEON_STORAGE_BUCKET=resources

# CORS: the deployed frontend origin (http://localhost:5173 is always allowed).
FRONTEND_ORIGIN=

# AI providers (free keys): Groq for speech-to-text, Google AI Studio for embeddings.
GROQ_API_KEY=
GROQ_MODEL_WHISPER=whisper-large-v3-turbo
GOOGLE_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001

# Largest accepted upload, in MB.
MAX_UPLOAD_MB=50

# Local name-detection model for Malay text (blank disables it).
# The Malay model declares no licence on Hugging Face.
PII_MALAY_MODEL=mesolitica/ner-t5-small-standard-bahasa-cased
# Load the models at startup instead of on the first Malay upload (first load takes 15-25 s).
PII_WARMUP=false

# Chat models. Free providers: Groq (fast), Gemini Flash-Lite, SEA-LION (Malay/Tamil specialist).
SEALION_API_KEY=
GROQ_MODEL_FAST=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.5-flash-lite
SEALION_MODEL=aisingapore/Qwen-SEA-LION-v4.5-27B-IT
# Provider order per language group (names: groq-fast, gemini, sealion).
LLM_CHAIN_EN=groq-fast,gemini,sealion
LLM_CHAIN_OTHER=gemini,sealion,groq-fast
# Longest wait (seconds) for a provider budget before skipping to the next provider.
LLM_MAX_WAIT_SECONDS=20

# Jira Cloud (optional). Create an API token at id.atlassian.com/manage-profile/security/api-tokens.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
